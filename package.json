{
  "name": "typewake",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TypeWake / 词醒 — 用打字唤醒词语的英文训练游戏",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "data:dialogues": "node scripts/gen-dialogues.mjs",
    "data:dict": "node scripts/patch-dict.mjs",
    "exe": "npm run desktop:build",
    "test": "node scripts/test-all.mjs",
    "test:growth": "node scripts/growth.mjs",
    "shot": "node scripts/shot.mjs",
    "icons": "node scripts/build-icons.mjs",
    "test:speech": "node scripts/test-speech.mjs",
    "translate": "node scripts/translate.mjs",
    "names": "node scripts/build-names.mjs",
    "verify": "node scripts/verify-tr.mjs",
    "trace": "node scripts/trace-source.mjs",
    "qa": "node scripts/qa-tr.mjs",
    "qa:sample": "node scripts/qa-sample.mjs --n 8",
    "qa:quotes": "node scripts/qa-quotes.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:data": "node scripts/verify-tr.mjs && node scripts/qa-tr.mjs --check",
    "test:daily": "node scripts/test-daily.mjs",
    "test:report": "node scripts/test-report.mjs",
    "test:cloze": "node scripts/test-cloze.mjs",
    "audit:cloze": "node scripts/audit-cloze.mjs",
    "audit:gloss": "node scripts/audit-gloss.mjs",
    "audit:dialogue": "node scripts/audit-dialogue.mjs",
    "audit:words": "node scripts/audit-words.mjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "tr:build": "node scripts/tr/build.mjs",
    "tr:status": "node scripts/tr/status.mjs",
    "tr:next": "node scripts/tr/next.mjs",
    "tr:export": "node scripts/tr/export.mjs",
    "desktop:typecheck": "tsc --noEmit -p tsconfig.bun.json",
    "desktop:dev": "hutch electrobun dev",
    "desktop:build": "npm run build && hutch electrobun build --env=stable",
    "lex": "node scripts/lex/status.mjs",
    "lex:next": "node scripts/lex/next-gloss.mjs --n=50",
    "prebuild": "node scripts/prebuild.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electrobun": "2.0.4",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
